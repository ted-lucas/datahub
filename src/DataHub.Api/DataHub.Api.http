@DataHub.Api_HostAddress = http://localhost:5275
@adminEmail = tedlucas@outlook.com
@adminPassword = DataZilla.247

### ---------------------------------------------------------------------------
### Auth: login (capture the accessToken into @token below for subsequent calls)
### ---------------------------------------------------------------------------
# @name login
POST {{DataHub.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
@token = {{login.response.body.accessToken}}

### ---------------------------------------------------------------------------
### Sports
### ---------------------------------------------------------------------------

### List sports
GET {{DataHub.Api_HostAddress}}/api/sports
Authorization: Bearer {{token}}

### Create sport
POST {{DataHub.Api_HostAddress}}/api/sports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Football",
  "slug": "football",
  "sortOrder": 20
}

### ---------------------------------------------------------------------------
### Sport Levels (e.g. Professional, College)
### ---------------------------------------------------------------------------

### List levels for a sport
# Replace {sportId} with a real GUID from the sports list
GET {{DataHub.Api_HostAddress}}/api/sports/{sportId}/levels
Authorization: Bearer {{token}}

### Create level
POST {{DataHub.Api_HostAddress}}/api/sports/{sportId}/levels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "College",
  "sortOrder": 20
}

### ---------------------------------------------------------------------------
### Leagues (e.g. MLB)
### ---------------------------------------------------------------------------

### List leagues for a level
GET {{DataHub.Api_HostAddress}}/api/sport-levels/{sportLevelId}/leagues
Authorization: Bearer {{token}}

### Create league
POST {{DataHub.Api_HostAddress}}/api/sport-levels/{sportLevelId}/leagues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "NCAA Division I Baseball",
  "abbreviation": "D1",
  "country": "USA"
}

### ---------------------------------------------------------------------------
### Conferences (e.g. AL, NL, AL East)
### ---------------------------------------------------------------------------

### List conferences for a league
GET {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/conferences
Authorization: Bearer {{token}}

### Create conference
POST {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/conferences
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "American League",
  "parentConferenceId": null
}

### ---------------------------------------------------------------------------
### Teams
### ---------------------------------------------------------------------------

### List teams for a league
GET {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/teams
Authorization: Bearer {{token}}

### Get team by id
GET {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}

### Create team
POST {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/teams
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Team",
  "city": "Anytown",
  "state": "CA",
  "country": "USA",
  "conferenceId": null,
  "venueId": null,
  "primaryColor": "#003366",
  "secondaryColor": "#FFFFFF"
}

### Update team
PUT {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Team",
  "city": "Othertown",
  "state": "CA",
  "country": "USA",
  "conferenceId": null,
  "venueId": null,
  "primaryColor": "#003366",
  "secondaryColor": "#FFFFFF"
}

### Soft-delete team
DELETE {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Venues
### ---------------------------------------------------------------------------

### List venues
GET {{DataHub.Api_HostAddress}}/api/venues
Authorization: Bearer {{token}}

### Create venue
POST {{DataHub.Api_HostAddress}}/api/venues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Stadium",
  "city": "Anytown",
  "state": "CA",
  "country": "USA",
  "lat": 37.7749,
  "lon": -122.4194,
  "capacity": 40000,
  "openedYear": 2000
}

### ---------------------------------------------------------------------------
### Geo: Countries
###
### Boundary geometry is no longer stored in the database. The map UI loads
### static GeoJSON / TopoJSON from /geo/* (served from wwwroot/geo/) and joins
### them to the metrics feed below by FIPS / ISO codes.
### ---------------------------------------------------------------------------

### List countries
GET {{DataHub.Api_HostAddress}}/api/geo/countries
Authorization: Bearer {{token}}

### Get country (USA) by ISO2
# @name getUsa
GET {{DataHub.Api_HostAddress}}/api/geo/countries/by-iso2/US
Authorization: Bearer {{token}}

###
@countryId = {{getUsa.response.body.id}}

### Get country by id
GET {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}

### Create country
POST {{DataHub.Api_HostAddress}}/api/geo/countries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "iso2": "CA",
  "iso3": "CAN",
  "name": "Canada"
}

### Update country
PUT {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "iso2": "US",
  "iso3": "USA",
  "name": "United States of America"
}

### Soft-delete country
DELETE {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: States
### ---------------------------------------------------------------------------

### List states for a country (path form, by country id)
GET {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}/states
Authorization: Bearer {{token}}

### List states for a country (query form, by ISO-2 — used by the map UI)
GET {{DataHub.Api_HostAddress}}/api/geo/states?country=US
Authorization: Bearer {{token}}

### Get state by id (replace {stateId} with a real GUID)
GET {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}

### Create state under USA
POST {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}/states
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "PR",
  "name": "Puerto Rico",
  "fips": "72"
}

### Update state
PUT {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CA",
  "name": "California",
  "fips": "06"
}

### Soft-delete state
DELETE {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: Counties
### ---------------------------------------------------------------------------

### List counties for a state (path form, by state id)
GET {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}/counties
Authorization: Bearer {{token}}

### List counties for a state (query form, by state FIPS — used by the map UI)
GET {{DataHub.Api_HostAddress}}/api/geo/counties?state=06
Authorization: Bearer {{token}}

### Get county by id
GET {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}

### Create county
POST {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}/counties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example County",
  "fips": "06999"
}

### Update county
PUT {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Renamed County",
  "fips": "06999"
}

### Soft-delete county
DELETE {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: Metrics (choropleth feed for the map UI)
###
### Returns one row per region at the requested level:
###   { fips, name, count }
###
### Query params:
###   level   country | state | county   (required-ish; defaults to state)
###   parent  optional scope. ISO-2 for state queries (e.g. US),
###           state FIPS for county queries (e.g. 06).
###   metric  regions | teams | venues   (default: regions)
###             regions = counts of geographic children (states-per-country, etc.)
###             teams   = Sports.Team rows joined by Team.State postal -> FIPS
###             venues  = Sports.Venue rows joined the same way
###           Teams/Venues degrade to `regions` at county level (those entities
###           don't store a county assignment yet).
### ---------------------------------------------------------------------------

### Country-level region counts (default metric)
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=country
Authorization: Bearer {{token}}

### State-level region counts (US)
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=state&parent=US
Authorization: Bearer {{token}}

### County-level region counts (California)
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=county&parent=06
Authorization: Bearer {{token}}

### Teams per country
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=country&metric=teams
Authorization: Bearer {{token}}

### Teams per US state
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=state&parent=US&metric=teams
Authorization: Bearer {{token}}

### Venues per US state
GET {{DataHub.Api_HostAddress}}/api/geo/metrics?level=state&parent=US&metric=venues
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: Static boundary files (no auth, long-cache)
### Served by ASP.NET Core static file middleware from wwwroot/geo/.
### ---------------------------------------------------------------------------

### Countries (TopoJSON, world-atlas)
GET {{DataHub.Api_HostAddress}}/geo/countries-110m.topo.json

### US states (TopoJSON, us-atlas)
GET {{DataHub.Api_HostAddress}}/geo/us-states-10m.topo.json

### US counties (TopoJSON, us-atlas)
GET {{DataHub.Api_HostAddress}}/geo/us-counties-10m.topo.json

###
