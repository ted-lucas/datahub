@DataHub.Api_HostAddress = http://localhost:5275
@adminEmail = tedlucas@outlook.com
@adminPassword = DataZilla.247

### ---------------------------------------------------------------------------
### Auth: login (capture the accessToken into @token below for subsequent calls)
### ---------------------------------------------------------------------------
# @name login
POST {{DataHub.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
@token = {{login.response.body.accessToken}}

### ---------------------------------------------------------------------------
### Sports
### ---------------------------------------------------------------------------

### List sports
GET {{DataHub.Api_HostAddress}}/api/sports
Authorization: Bearer {{token}}

### Create sport
POST {{DataHub.Api_HostAddress}}/api/sports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Football",
  "slug": "football",
  "sortOrder": 20
}

### ---------------------------------------------------------------------------
### Sport Levels (e.g. Professional, College)
### ---------------------------------------------------------------------------

### List levels for a sport
# Replace {sportId} with a real GUID from the sports list
GET {{DataHub.Api_HostAddress}}/api/sports/{sportId}/levels
Authorization: Bearer {{token}}

### Create level
POST {{DataHub.Api_HostAddress}}/api/sports/{sportId}/levels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "College",
  "sortOrder": 20
}

### ---------------------------------------------------------------------------
### Leagues (e.g. MLB)
### ---------------------------------------------------------------------------

### List leagues for a level
GET {{DataHub.Api_HostAddress}}/api/sport-levels/{sportLevelId}/leagues
Authorization: Bearer {{token}}

### Create league
POST {{DataHub.Api_HostAddress}}/api/sport-levels/{sportLevelId}/leagues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "NCAA Division I Baseball",
  "abbreviation": "D1",
  "country": "USA"
}

### ---------------------------------------------------------------------------
### Conferences (e.g. AL, NL, AL East)
### ---------------------------------------------------------------------------

### List conferences for a league
GET {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/conferences
Authorization: Bearer {{token}}

### Create conference
POST {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/conferences
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "American League",
  "parentConferenceId": null
}

### ---------------------------------------------------------------------------
### Teams
### ---------------------------------------------------------------------------

### List teams for a league
GET {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/teams
Authorization: Bearer {{token}}

### Get team by id
GET {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}

### Create team
POST {{DataHub.Api_HostAddress}}/api/leagues/{leagueId}/teams
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Team",
  "city": "Anytown",
  "state": "CA",
  "country": "USA",
  "conferenceId": null,
  "venueId": null,
  "primaryColor": "#003366",
  "secondaryColor": "#FFFFFF"
}

### Update team
PUT {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Team",
  "city": "Othertown",
  "state": "CA",
  "country": "USA",
  "conferenceId": null,
  "venueId": null,
  "primaryColor": "#003366",
  "secondaryColor": "#FFFFFF"
}

### Soft-delete team
DELETE {{DataHub.Api_HostAddress}}/api/teams/{teamId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Venues
### ---------------------------------------------------------------------------

### List venues
GET {{DataHub.Api_HostAddress}}/api/venues
Authorization: Bearer {{token}}

### Create venue
POST {{DataHub.Api_HostAddress}}/api/venues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Stadium",
  "city": "Anytown",
  "state": "CA",
  "country": "USA",
  "lat": 37.7749,
  "lon": -122.4194,
  "capacity": 40000,
  "openedYear": 2000
}

### ---------------------------------------------------------------------------
### Geo: Countries
### ---------------------------------------------------------------------------

### List countries
GET {{DataHub.Api_HostAddress}}/api/geo/countries
Authorization: Bearer {{token}}

### Get country (USA) by ISO2
# @name getUsa
GET {{DataHub.Api_HostAddress}}/api/geo/countries/by-iso2/US
Authorization: Bearer {{token}}

###
@countryId = {{getUsa.response.body.id}}

### Get country by id
GET {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}

### Create country
POST {{DataHub.Api_HostAddress}}/api/geo/countries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "iso2": "CA",
  "iso3": "CAN",
  "name": "Canada"
}

### Update country
PUT {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "iso2": "US",
  "iso3": "USA",
  "name": "United States of America"
}

### Set country geometry (GeoJSON Polygon or MultiPolygon, WGS84 lon/lat)
PUT {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}/geometry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "geoJson": "{\"type\":\"Polygon\",\"coordinates\":[[[-125,24],[-66,24],[-66,49],[-125,49],[-125,24]]]}"
}

### Soft-delete country
DELETE {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: States
### ---------------------------------------------------------------------------

### List states for USA
GET {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}/states
Authorization: Bearer {{token}}

### Get state by id
# Replace with a real GUID from the list above
GET {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}

### Create state under USA
POST {{DataHub.Api_HostAddress}}/api/geo/countries/{{countryId}}/states
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "PR",
  "name": "Puerto Rico",
  "fips": "72"
}

### Update state
PUT {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CA",
  "name": "California",
  "fips": "06"
}

### Set state geometry
PUT {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}/geometry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "geoJson": "{\"type\":\"Polygon\",\"coordinates\":[[[-124,32],[-114,32],[-114,42],[-124,42],[-124,32]]]}"
}

### Soft-delete state
DELETE {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: Counties
### ---------------------------------------------------------------------------

### List counties for a state
GET {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}/counties
Authorization: Bearer {{token}}

### Get county by id
GET {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}

### Create county
POST {{DataHub.Api_HostAddress}}/api/geo/states/{stateId}/counties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example County",
  "fips": "06999"
}

### Update county
PUT {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Renamed County",
  "fips": "06999"
}

### Set county geometry
PUT {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}/geometry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "geoJson": "{\"type\":\"Polygon\",\"coordinates\":[[[-122.5,37.7],[-122.3,37.7],[-122.3,37.9],[-122.5,37.9],[-122.5,37.7]]]}"
}

### Soft-delete county
DELETE {{DataHub.Api_HostAddress}}/api/geo/counties/{countyId}
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------------
### Geo: Cache files (served as static GeoJSON, no auth)
### Layout:
###   /geo-cache/countries/{id}.geojson           single country feature
###   /geo-cache/states/{id}.geojson              single state feature
###   /geo-cache/counties/{id}.geojson            single county feature
###   /geo-cache/states/bundle-{countryId}.geojson    FeatureCollection of states
###   /geo-cache/counties/bundle-{stateId}.geojson    FeatureCollection of counties
### ---------------------------------------------------------------------------

### Fetch the USA -> states bundle
GET {{DataHub.Api_HostAddress}}/geo-cache/states/bundle-{{countryId}}.geojson

### Fetch a state -> counties bundle
GET {{DataHub.Api_HostAddress}}/geo-cache/counties/bundle-{stateId}.geojson

### Fetch a single state feature
GET {{DataHub.Api_HostAddress}}/geo-cache/states/{stateId}.geojson

###
