# DataHub - Environment Variables Reference
#
# This file documents the configuration values DataHub needs to run.
# DEV: values are stored directly in src/DataHub.Api/appsettings.Development.json (which is gitignored).
# PROD: values should be supplied via environment variables (or appsettings.Production.json, also gitignored).
#
# When using environment variables, .NET's config system maps "__" to ":" / nested keys.
# Example: ConnectionStrings__DefaultConnection => ConnectionStrings:DefaultConnection

# ---- SQL Server connection ----
ConnectionStrings__DefaultConnection="Server=YOUR_SERVER;Database=DataHub-Dev;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# ---- JWT settings ----
# Key MUST be at least 32 characters. Use a strong random value in production.
Jwt__Key="change-me-to-a-long-random-string-at-least-32-chars"
Jwt__Issuer="DataHub"
Jwt__Audience="DataHub"
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- ASP.NET environment ----
ASPNETCORE_ENVIRONMENT=Development
